{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "core_rules", "scene_policies", "output_policy"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "language"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 1}
      }
    },
    "core_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "priority", "instruction"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "priority": {"enum": ["critical", "high", "medium", "low"]},
          "instruction": {"type": "string", "minLength": 1}
        }
      }
    },
    "scene_policies": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["required_topics", "excluded_topics", "reasoning_rules"],
        "properties": {
          "required_topics": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "excluded_topics": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "reasoning_rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "output_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "constraints"],
      "properties": {
        "order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "constraints": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
